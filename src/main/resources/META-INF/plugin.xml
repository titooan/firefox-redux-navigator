<idea-plugin>
    <id>org.mozilla.firefox-redux-navigator</id>
    <name>Firefox Redux Navigator</name>
    <vendor email="tthibaud@mozilla.com">Mozilla</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider
            language="kotlin"
            implementationClass="org.mozilla.reduxnav.gutter.ReduxActionLineMarkerProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="org.mozilla.reduxnav.inlay.ReduxActionInlayHintsProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider implementation="org.mozilla.reduxnav.inlay.ReduxStateInlayHintsProvider"/>
        <config.codeVisionGroupSettingProvider implementation="org.mozilla.reduxnav.inlay.ReduxActionCodeVisionGroupSettingProvider"/>
        <config.codeVisionGroupSettingProvider implementation="org.mozilla.reduxnav.inlay.ReduxStateCodeVisionGroupSettingProvider"/>
        <toolWindow
            id="Redux Flow"
            anchor="right"
            factoryClass="org.mozilla.reduxnav.toolwindow.ReduxFlowToolWindowFactory"/>
        <notificationGroup
            id="Redux Navigator"
            displayType="BALLOON"
            isLogByDefault="false"/>
        <applicationConfigurable
            instance="org.mozilla.reduxnav.settings.ReduxNavigatorSettingsConfigurable"
            id="org.mozilla.reduxnav.settings.ReduxNavigatorSettings"
            displayName="Redux Navigator"/>
        <postStartupActivity implementation="org.mozilla.reduxnav.startup.ReduxNavigatorSandboxStartupActivity"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <action
            id="org.mozilla.reduxnav.ShowReduxFlow"
            class="org.mozilla.reduxnav.toolwindow.ShowReduxFlowAction"
            text="Show Redux Flow"
            description="Show Redux dispatch, middleware, and reducer flow for this action">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action
            id="org.mozilla.reduxnav.ShowReduxStateChanges"
            class="org.mozilla.reduxnav.state.StateExplorerAction"
            text="Show Redux State Changes"
            description="Show Redux actions and reducers that modify this state field">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
